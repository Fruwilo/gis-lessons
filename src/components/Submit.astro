---
// ====================================================
// Submit.astro — «Что сдать»
//
// Последний блок урока: имя файла, формат, что должно быть внутри,
// куда прислать. Без него присылают скриншот вместо проекта.
//
// Использование в .mdx:
//   <Submit deadline="до конца занятия" where="LMS, задание «Занятие 1»">
//   **Что:** `Фамилия.qgz` и `Фамилия_screen.png`
//
//   **Внутри проекта:** СК `EPSG:32636`, слой границ с фильтром…
//   </Submit>
// ====================================================

interface Props {
  /** Срок сдачи: «до конца занятия», «до следующего занятия» */
  deadline?: string;
  /** Куда сдавать: «LMS, задание «Занятие 1»» */
  where?: string;
}

const { deadline, where } = Astro.props;
---

<section class="submit my-8 rounded-lg border-2 border-[var(--color-accent)] bg-[var(--color-surface)] overflow-hidden">
  <header
    class="flex flex-wrap items-center gap-x-3 gap-y-1 px-4 py-3"
    style="background-color: var(--color-accent-muted);"
  >
    <svg
      width="18" height="18" viewBox="0 0 24 24" fill="none"
      stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
      style="color: var(--color-accent);" aria-hidden="true"
    >
      <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z" />
      <path d="M14 2v6h6" />
      <path d="m9 15 2 2 4-4" />
    </svg>

    <span class="font-semibold" style="color: var(--color-accent);">Что сдать</span>

    {deadline && (
      <span class="ml-auto text-xs px-2 py-1 rounded-full bg-[var(--color-surface)] text-[var(--color-text-muted)]">
        {deadline}
      </span>
    )}
  </header>

  <div class="submit-body px-4 py-3 text-[0.95rem] leading-relaxed">
    {where && (
      <p class="!mt-0 text-[var(--color-text-muted)]">
        <span class="font-semibold text-[var(--color-text)]">Куда:</span> {where}
      </p>
    )}
    <slot />
  </div>
</section>

<style>
  .submit-body :global(p:first-child) { margin-top: 0; }
  .submit-body :global(p:last-child),
  .submit-body :global(ul:last-child),
  .submit-body :global(ol:last-child) { margin-bottom: 0; }

  .submit-body :global(ul),
  .submit-body :global(ol) { margin-top: 0.4rem; }
</style>
