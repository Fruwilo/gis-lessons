---
// ====================================================
// Rescue.astro — файл-спасатель
//
// Готовый файл на состояние «после этого шага». Нужен, чтобы человек,
// у которого что-то не вышло, догнал группу, а не выпал из занятия.
//
// Использование в .mdx:
//   <Rescue href="https://disk.yandex.ru/d/..." step="после части 2">
//   Внутри — проект с подложкой и слоем границ.
//   </Rescue>
//
// Оформление намеренно спокойное: если блок выглядит как сообщение
// об ошибке, им не пользуются и молча отстают.
// ====================================================

interface Props {
  /** Прямая ссылка на файл или папку */
  href: string;
  /** На какое состояние файл: «после части 2», «после шага 7» */
  step?: string;
  /** Подпись на кнопке */
  label?: string;
}

const { href, step, label = 'Скачать файл' } = Astro.props;
---

<aside class="my-6 rounded-lg border border-[var(--color-border)] bg-[var(--color-surface-muted)] px-4 py-4">
  <div class="flex items-start gap-3">
    <svg
      class="mt-0.5 shrink-0" width="18" height="18" viewBox="0 0 24 24" fill="none"
      stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
      style="color: var(--color-info);" aria-hidden="true"
    >
      <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4" />
      <path d="M7 10l5 5 5-5" />
      <path d="M12 15V3" />
    </svg>

    <div class="flex-1 min-w-0">
      <div class="font-semibold mb-1">
        Не получилось? Возьмите готовый файл
      </div>

      <div class="text-[0.9rem] text-[var(--color-text-muted)] leading-relaxed rescue-body">
        <slot />
      </div>

      <a
        href={href}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-2 mt-3 px-3 py-1.5 rounded-md text-sm font-medium
               bg-[var(--color-surface)] border border-[var(--color-border)]
               hover:border-[var(--color-info)] transition-colors
               focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2"
        style="outline-color: var(--color-info);"
      >
        {label}
        {step && <span class="text-[var(--color-text-muted)] font-normal">· {step}</span>}
      </a>
    </div>
  </div>
</aside>

<style>
  .rescue-body :global(p:first-child) { margin-top: 0; }
  .rescue-body :global(p:last-child) { margin-bottom: 0; }
</style>
