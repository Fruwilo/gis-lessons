---
// ====================================================
// Callout.astro — цветной блок-врезка
// Использование в уроке (.mdx):
//   <Callout type="tip">Текст совета</Callout>
//   <Callout type="warning" title="Осторожно">...</Callout>
// ====================================================

import { getLangFromUrl, useTranslations } from '../i18n/ui';

interface Props {
  type?: 'tip' | 'warning' | 'info' | 'attention';
  title?: string;
}

const { type = 'info', title } = Astro.props;

// Заголовок по умолчанию — на языке урока (см. src/i18n/ui.ts)
const t = useTranslations(getLangFromUrl(Astro.url));

// Для каждого типа: цвет (имя CSS-переменной) и эмодзи
const config = {
  tip:       { color: 'success',   icon: '💡' },
  warning:   { color: 'warning',   icon: '⚠️' },
  info:      { color: 'info',      icon: 'ℹ️' },
  attention: { color: 'attention', icon: '👀' },
} as const;

const c = config[type];
---

<aside
  class="my-5 rounded-md border-l-4 px-4 py-3"
  style={`border-left-color: var(--color-${c.color}); background-color: var(--color-${c.color}-muted);`}
>
  <div class="font-semibold mb-1">
    <span class="mr-1">{c.icon}</span>{title ?? t(`callout.${type}`)}
  </div>
  <div class="text-[0.95rem] leading-relaxed">
    <slot />
  </div>
</aside>